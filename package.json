{
  "name": "fitme",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.17",
    "expo-font": "~58.0.9",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "check": "node --import ./scripts/resolve-hook.mjs scripts/check.mjs",
    "doctor": "npx expo-doctor",
    "assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-assets.ps1",
    "demos:preview": "node --import ./scripts/resolve-hook.mjs scripts/demo-preview.mjs \"\" demo-preview.json && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/demo-preview.ps1 demo-preview.json demo-preview.png 8",
    "build:apk:cloud": "npx eas-cli@latest build --platform android --profile preview",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "private": true,
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4"
  }
}
