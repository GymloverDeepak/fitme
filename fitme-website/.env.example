# Copy this file to `.env.local` for local testing, or add the same names in
# Vercel → Project → Settings → Environment Variables. These values are PUBLIC (shown in the browser).

# Real https:// download link of the FITME APK (e.g. a GitHub Release asset). Leave empty until it exists.
VITE_APK_URL=

# Optional — only fill these in with values verified from the real APK file.
VITE_APK_VERSION=
VITE_APK_SIZE=
